# Cupdom CRM (Next.js) — copy to .env.local and fill in.
# Both values are PUBLIC-safe: the anon/publishable key is RLS-gated.
NEXT_PUBLIC_SUPABASE_URL=https://uqkbvwyspeqwlbulgzkj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# The SUPABASE_SERVICE_ROLE_KEY is NEVER placed in a NEXT_PUBLIC_* var and never
# shipped to the browser. It stays server-side only (Netlify env, for the scan
# edge function and future server jobs).

# ── QR redirector / scan edge function (Spec 2A/2B) — NETLIFY env, NOT Next env ──
# The /s/:slug edge function (netlify/edge-functions/scan.js) reads these server-side:
#   SUPABASE_URL                — Supabase project URL (server copy; no NEXT_PUBLIC_ prefix)
#   SUPABASE_SERVICE_ROLE_KEY   — service-role key (bypasses RLS to write qr_scans); SECRET, server-only
#   QR_DAILY_SECRET             — pepper for the daily visitor_hash (rotating dedup); SECRET
#   QR_FALLBACK_URL             — default origin if PUBLIC_BASE_URL is unset (e.g. https://cupdom.fr)
#   PUBLIC_BASE_URL             — NON-secret. Absolute origin used to build the hand-off URLs
#                                 (Active scan -> /c/<slug> lead form; Terminée/unknown -> /campagne-terminee).
#                                 e.g. https://cupdom.fr — MUST be set so the 302 targets are absolute.
# Since Spec 2B, the redirector no longer 302s a scanner straight to the sponsor: Active campaigns
# go to the lead form /c/<slug> (Spec 3A applies the destination after capture); Terminée campaigns
# and unknown slugs go to the branded /campagne-terminee page.

# ── Daily digest email (Spec 1D) — Supabase EDGE FUNCTION secrets, NOT Next env ──
# Set with the Supabase CLI (they never reach the browser):
#   supabase secrets set RESEND_API_KEY=re_xxx \
#     "DIGEST_FROM=Cupdom <crm@cupdom.fr>" DIGEST_CRON_SECRET=<random>
#   RESEND_API_KEY      — Resend API key (provider: Resend; Postmark = fallback)
#   DIGEST_FROM         — verified cupdom.fr sender (add Resend SPF/DKIM DNS records first)
#   DIGEST_CRON_SECRET  — shared secret checked by the function (pg_cron -> Edge Function)
#
# One-time DB setup (Dashboard -> Database -> Extensions): enable pg_cron AND pg_net,
# then seed the cron->function call (values NOT committed):
#   insert into public.app_config(key,value) values
#     ('digest_fn_url','https://<ref>.functions.supabase.co/daily-digest'),
#     ('digest_cron_secret','<same random as DIGEST_CRON_SECRET>')
#   on conflict (key) do update set value = excluded.value;
# Deploy the function: supabase functions deploy daily-digest
# The digest cron runs 06:00 UTC (~08:00 Europe/Paris in summer; UTC has no DST).
